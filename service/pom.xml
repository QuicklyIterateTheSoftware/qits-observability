<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-observability</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The whole telemetry context, in one module: `eu.wohlben.qits.telemetry.{api,control,dto,
         mcp,error}`. Unlike every other qits context there is no domain/service split, because
         there was none to replay — migration-plan.md §3.6: telemetry is the one domain whose
         business logic already lived entirely in the monorepo's `service` module. The buffer is
         in-memory, so the usual reason for a framework-free `domain` jar (entities + persistence
         + its own Flyway lineage) does not apply.

         DIRECTORY vs ARTIFACT: the directory is `service/` because the replayed git history is
         anchored to service/src/**; the artifactId is `qits-telemetry` because that is the settled
         name for the module inside qits-observability (superproject commit 1919396). The two are
         allowed to disagree — directories are load-bearing here, artifactIds are not.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the OTLP receiver, the REST routes and the MCP tools" —
         on the reasoning that packaging it would need an auth variant, a webui and a main class.
         Each of those has since stopped being true: authentication terminates at qits-gateway and
         this module reads a header (see security/), the webui stays in the monorepo and is not this
         context's concern, and Quarkus supplies the main class. What remained was a receiver that
         no process could start and the gateway had nothing to route to.

         See migration-deployables-plan.md in the superproject; the same change is owed to the other
         five extracted services, which are still library JARs for the same lapsed reason. -->
    <artifactId>qits-telemetry</artifactId>
    <name>qits-observability :: telemetry</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity + the HttpAuthenticationMechanism SPI, for the single thing this
                 service does about auth: read qits-gateway's X-Qits-User header into an identity
                 (see security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <!-- The JSON query surface (WorkspaceTelemetryController) and the protobuf ingest
                 routes (OtelReceiverResource). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- @Operation(hidden = true) on the wire-protocol endpoints. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP wire-format bindings for the in-process receiver (OtelReceiverResource).
                 Pulls protobuf-java transitively. Version pinned in the parent. -->
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
        </dependency>
        <dependency>
            <!-- MCP server (Streamable HTTP + legacy SSE): the telemetry tools mount on the
                 "repository" server. Version pinned in the parent. -->
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar: `quarkus-observability` is a
                     process that receives OTLP and answers queries over what it received, and it
                     has to be runnable on its own for the gateway to have anything to route to.
                     Augmentation is what produces target/quarkus-app/quarkus-run.jar; without this
                     execution `mvn verify` proves the tests pass and proves nothing about whether
                     the thing starts. Version comes from the root pom's pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
